# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TAVILY_API_KEY: Required for live web evidence retrieval via Tavily Search API.
TAVILY_API_KEY="tvly-YOUR_TAVILY_API_KEY"

# BIFROST_BASE_URL: Base URL of your Bifrost by Maxim AI gateway (e.g. http://localhost:8080 or https://bifrost.yourdomain.com)
BIFROST_BASE_URL="https://YOUR_BIFROST_GATEWAY_URL"

# BIFROST_API_KEY: Virtual key (sk-bf-...) or gateway bearer token for Bifrost
BIFROST_API_KEY="sk-bf-YOUR_BIFROST_KEY"

# BIFROST_MODEL: Model identifier configured in Bifrost (e.g. openai/gpt-4o-mini or gpt-4o)
BIFROST_MODEL="openai/gpt-4o-mini"

# MAX_INPUT_CHARS: Maximum allowed characters per submitted AI answer (default: 12000)
MAX_INPUT_CHARS="12000"
